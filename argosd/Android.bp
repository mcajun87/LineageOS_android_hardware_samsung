cc_binary {
    name: "argosd",
    srcs: [
        "argos.c",
        "main.c",
    ],
    local_include_dirs: [
        "include",
    ],
    shared_libs: [
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    init_rc: [
        "argosd.rc",
    ],
}
